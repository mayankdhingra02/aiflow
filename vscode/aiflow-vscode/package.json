{
  "name": "aiflow-vscode",
  "displayName": "Aiflow Companion",
  "description": "Live viewer and controller for the Codex run owned by the Aiflow menu-bar app.",
  "version": "0.0.1",
  "private": true,
  "publisher": "aiflow-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiflow",
          "title": "Aiflow",
          "icon": "media/aiflow.svg"
        }
      ]
    },
    "views": {
      "aiflow": [
        {
          "id": "aiflow.runView",
          "name": "Current Run"
        }
      ]
    },
    "commands": [
      {
        "command": "aiflow.reconnect",
        "title": "Aiflow: Reconnect",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "aiflow.cancelRun",
        "title": "Aiflow: Cancel Run",
        "icon": "$(stop-circle)"
      },
      {
        "command": "aiflow.approve",
        "title": "Aiflow: Allow Once",
        "icon": "$(check)"
      },
      {
        "command": "aiflow.deny",
        "title": "Aiflow: Deny",
        "icon": "$(circle-slash)"
      },
      {
        "command": "aiflow.answerQuestion",
        "title": "Aiflow: Answer Codex Question",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "aiflow.focusView",
        "title": "Aiflow: Show Current Run"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aiflow.approve",
          "when": "view == aiflow.runView && aiflow.waitingForApproval",
          "group": "navigation@1"
        },
        {
          "command": "aiflow.deny",
          "when": "view == aiflow.runView && aiflow.waitingForApproval",
          "group": "navigation@2"
        },
        {
          "command": "aiflow.answerQuestion",
          "when": "view == aiflow.runView && aiflow.waitingForInput",
          "group": "navigation@3"
        },
        {
          "command": "aiflow.cancelRun",
          "when": "view == aiflow.runView",
          "group": "navigation@4"
        },
        {
          "command": "aiflow.reconnect",
          "when": "view == aiflow.runView",
          "group": "navigation@5"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
